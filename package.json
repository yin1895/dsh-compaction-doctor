{
  "name": "@local/dsh-compaction-doctor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Probe a DSH route's real full context window, write it into the profile config, and make compaction (auto + /compact) survive it: real-scale retention pricing, chunked hierarchical summarization, and overflow classification for non-English provider errors.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "compaction"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./probe": "./lib/probe.js",
    "./engine": "./lib/engine.js",
    "./plan": "./lib/plan.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-config-editor": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.3"
}
