{
  "name": "@local/dsh-compaction-doctor",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "DSH 上下文压缩诊断与修复插件：探测路由真实可用窗口、在设置页里用几个按钮完成「诊断 → 修复 → 状态监控 → 回滚」，并从装配缝上修好压缩（真实尺度保留定价、分块摘要、非英文溢出报错识别）。",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "compaction",
    "settings"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./probe": "./lib/probe.js",
    "./engine": "./lib/engine.js",
    "./status": "./lib/status.js",
    "./plan": "./lib/plan.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/nm/run.mjs",
    "test:client": "node test/client/run.mjs",
    "test:all": "node test/nm/run.mjs && node test/client/run.mjs"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-config-editor": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.3"
}