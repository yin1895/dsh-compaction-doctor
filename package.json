{
  "name": "@local/dsh-compaction-doctor",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "DSH 上下文压缩插件：设置里一个开关，打开后按你正在使用的模型自动校正上下文长度配置（改前逐字节备份）；关掉即完全惰性。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yin1895/dsh-compaction-doctor.git"
  },
  "homepage": "https://github.com/yin1895/dsh-compaction-doctor#readme",
  "bugs": {
    "url": "https://github.com/yin1895/dsh-compaction-doctor/issues"
  },
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "compaction",
    "settings"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./probe": "./lib/probe.js",
    "./engine": "./lib/engine.js",
    "./status": "./lib/status.js",
    "./plan": "./lib/plan.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/nm/run.mjs",
    "test:client": "node test/client/run.mjs",
    "test:model": "node test/model/check.mjs",
    "test:all": "node test/nm/run.mjs && node test/client/run.mjs && node test/model/check.mjs"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-config-editor": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.3"
}